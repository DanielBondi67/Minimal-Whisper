[Desktop Entry]
Type=Application
Name=Minimal Whisper Tray
Comment=Minimal Whisper status and settings tray icon
Exec=/bin/sh -c "systemctl --user import-environment DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME; exec systemctl --user start --no-block minimal-whisper-control.service"
TryExec=/usr/bin/systemctl
Icon=minimal-whisper
Terminal=false
X-GNOME-Autostart-enabled=true
StartupNotify=false
