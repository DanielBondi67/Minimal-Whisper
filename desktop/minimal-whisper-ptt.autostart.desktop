[Desktop Entry]
Type=Application
Name=Minimal Whisper Push-to-Talk
Comment=Hold Super+Ctrl+Y to record and transcribe offline
Exec=/bin/sh -c "systemctl --user import-environment DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME; exec systemctl --user start --no-block minimal-whisper-ptt.service"
TryExec=/usr/bin/systemctl
Terminal=false
X-GNOME-Autostart-enabled=true
