#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
    control) unit=minimal-whisper-control.service; command=minimal-whisper-control; args=(--background) ;;
    ptt) unit=minimal-whisper-ptt.service; command=minimal-whisper-ptt; args=() ;;
    *) echo 'Usage: minimal-whisper-start {control|ptt}' >&2; exit 2 ;;
esac

if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
    systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_SESSION_TYPE \
        XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME >/dev/null 2>&1 || true
    exec systemctl --user start --no-block "$unit"
fi

exec "$HOME/.local/bin/$command" "${args[@]}"
