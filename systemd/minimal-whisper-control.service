[Unit]
Description=Minimal Whisper tray and settings app
After=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0.0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/usr/bin/python %h/.local/bin/minimal-whisper-control.py --background
Restart=on-failure
RestartSec=2
TimeoutStopSec=4
KillMode=control-group
