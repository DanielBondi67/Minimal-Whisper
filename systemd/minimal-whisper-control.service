[Unit]
Description=Minimal Whisper tray and settings app
After=graphical-session.target

[Service]
Type=simple
PassEnvironment=DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME
ExecStart=%h/.local/bin/minimal-whisper-control --background
Restart=on-failure
RestartSec=2
TimeoutStopSec=4
KillMode=control-group
