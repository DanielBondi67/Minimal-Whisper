[Unit]
Description=Minimal Whisper push-to-talk shortcut listener

[Service]
Type=simple
Environment=DISPLAY=:0.0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/.local/opt/openai-whisper/bin/python %h/.local/bin/minimal-whisper-ptt.py
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=6
